# fast-syntax-highlighting's secondary theme: the styles for nested code such as `$(…)` and backquotes.
# While this file is missing, the plugin downloads share/free_theme.zsh here (see FAST_WORK_DIR in ~/.zshrc);
# this loads the copy the plugin ships instead. FAST_BASE_DIR is the plugin's directory
# (fast-syntax-highlighting.plugin.zsh, zdharma-continuum 4672ad5).
source "$FAST_BASE_DIR/share/free_theme.zsh"
